{
  "name": "autograd-ts",
  "version": "0.1.5",
  "description": "A tiny reverse-mode automatic differentiation engine in TypeScript",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "vitest run tests/value.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run test:package",
    "test:package": "npm run build && node scripts/test-package.mjs"
  },
  "keywords": [
    "autograd",
    "machine-learning",
    "neural-networks",
    "automatic-differentiation",
    "typescript"
  ],
  "author": "Eyas Ranjous <eyas.ranjous@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "type": "commonjs"
}
